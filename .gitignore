# Binarios compilados
/sv-memory
/sv-memory.exe
/bin/
/dist/
*.exe~
*.dll
*.so
*.dylib

# Archivos de base de datos locales (si los hay)
*.db
*.sqlite

# Carpetas temporales y de dependencias
/vendor/
.venv/
venv/
__pycache__/

# Clutter del sistema operativo
.DS_Store
Thumbs.db

# sv-memory store is local-only: it can contain internal decisions, journals and
# Q&A reasoning. Keep it out of version control (public repos expose it to the
# world). Private teams can opt into Git sync per project with
# 'sv-memory configure set git_sync_enabled true --local'.
.sv-memory/
